{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "design-preview": "ng serve --configuration design-preview --host 127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:vercel": "node scripts/configure-vercel.mjs && ng build --configuration production",
    "build:preview": "ng build --configuration design-preview --optimization --source-map=false --output-hashing=all --output-path=dist/design-preview && node scripts/export-design-preview.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/cdk": "~21.1.5",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.1.6",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@clerk/clerk-js": "^6.3.0",
    "rxjs": "~7.8.0",
    "swiper": "^12.1.2",
    "tslib": "^2.3.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/material": "^21.1.6",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
